@startuml
' Source (synthetic brief): the bookshop on Google Cloud. The till system (in-store, hosting not
' stated) uploads a daily CSV to a Cloud Storage landing bucket. Order changes in Cloud SQL are
' published to Pub/Sub and streamed by Dataflow into the BigQuery sales warehouse; a nightly Cloud
' Composer DAG loads the landing bucket's CSV into BigQuery.
' Not stated: nothing beyond the hosting of the till system.
' house-preamble-begin
' Knob LEGEND_FRAME: colour of the thin frame around the legend ("transparent" removes it).
!$LEGEND_FRAME = "#999999"
!theme plain
skinparam linetype ortho
skinparam wrapWidth 300
skinparam maxMessageSize 300
skinparam legendBackgroundColor transparent
skinparam legendBorderColor $LEGEND_FRAME
skinparam nodesep 60
skinparam ranksep 80
hide stereotype
<style>
root { FontName "Helvetica"; FontSize 12 }
title { FontSize 16 }
.GcpCloud { LineColor #4285F4; LineThickness 2; FontColor #4285F4; FontStyle bold; HorizontalAlignment left }
.GcpStage { LineColor #9AA0A6; LineStyle 6; LineThickness 2; BackgroundColor #F1F3F4; HorizontalAlignment left }
.ZoneProcessing { BackgroundColor #E1F5FE; LineColor #E1F5FE; HorizontalAlignment left }
.ZoneStorage { BackgroundColor #FFF8E1; LineColor #FFF8E1; HorizontalAlignment left }
.ZoneAnalytics { BackgroundColor #F1F8E9; LineColor #F1F8E9; HorizontalAlignment left }
.ZoneServing { BackgroundColor #F3E5F5; LineColor #F3E5F5; HorizontalAlignment left }
.ZoneOnPrem { BackgroundColor #EFEBE9; LineColor #EFEBE9; HorizontalAlignment left }
.ZoneExternal { BackgroundColor #FFEBEE; LineColor #FFEBEE; HorizontalAlignment left }
.LogicalFrame { LineColor #4284F3; LineStyle 6; LineThickness 2; BackgroundColor transparent; FontColor #4284F3; HorizontalAlignment left }
.NotStated { LineColor #999999; LineStyle 2; FontColor #666666; HorizontalAlignment left }
</style>
!include <gcp/GCPCommon>
' Numbered steps (optional, STYLE rule 16): $step(1) prints a blue badge in a label, an edge label
' or a legend table row. Knob STEP_BADGE: the badge colour.
!$STEP_BADGE = "#1565C0"
!function $step($n)
!return "<back:" + $STEP_BADGE + "><color:#FFFFFF><b> " + $n + " </b></color></back>"
!endfunction
' house-preamble-end
!include <gcp/Storage/Cloud_Storage>
!include <gcp/Data_Analytics/Cloud_PubSub>
!include <gcp/Data_Analytics/Cloud_Dataflow>
!include <gcp/Data_Analytics/BigQuery>
!include <gcp/Data_Analytics/Cloud_Composer>
!include <gcp/Databases/Cloud_SQL>

title Container diagram for the bookshop sales data platform on Google Cloud (synthetic)

rectangle "Till system\n(in-store, hosting not stated)" as till <<NotStated>>
rectangle "Google Cloud" as gc <<GcpCloud>> {
  rectangle "Ingest" as g_in <<GcpStage>> {
    Cloud_Storage(landing, "Landing bucket", "Cloud Storage")
    Cloud_SQL(orders, "Orders DB", "Cloud SQL for PostgreSQL")
    Cloud_PubSub(events, "Order events", "Pub/Sub")
  }
  rectangle "Warehouse" as g_wh <<GcpStage>> {
    Cloud_Composer(composer, "Nightly DAG", "Cloud Composer")
    Cloud_Dataflow(flow, "Order pipeline", "Dataflow")
    BigQuery(dw, "Sales warehouse", "BigQuery")
  }
  circle " " as j_csv
}

skinparam nodesep 90
skinparam ranksep 110
till ---> landing : uploads daily CSV\n(HTTPS)
orders -down-> events : publishes\nchanges (CDC)
events -down-> flow : streams orders\n(Pub/Sub)
flow -down-> dw : writes rows\n(Write API)
landing -down-> j_csv : CSV files\n(GCS)
j_csv -down-> dw
composer -down-> dw : loads CSV\n(load job)
landing -[hidden]right- orders
flow -[hidden]right- composer

legend bottom
  |= Mark |= Meaning |
  | icon | Google Cloud service named in the source (official GCP icon) |
  | blue frame | Google Cloud |
  | grey dashed frame | stage of the platform |
  | grey dotted frame | hosting not stated |
  | small circle | junction: one line continued, labelled once |
endlegend
@enduml
